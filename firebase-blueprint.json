{
  "entities": {
    "laporan_kegiatan": {
      "title": "Laporan Kegiatan",
      "description": "Laporan bimbingan dan penyuluhan agama dan pembangunan",
      "type": "object",
      "properties": {
        "penyuluhId": { "type": "string" },
        "penyuluhNama": { "type": "string" },
        "penyuluhNip": { "type": "string" },
        "kelompokSasaran": { "type": "string" },
        "kontakKelompok": { "type": "string" },
        "kategoriMateri": { "type": "string" },
        "judulMateri": { "type": "string" },
        "deskripsiKegiatan": { "type": "string" },
        "deskripsiSingkatMateri": { "type": "string" },
        "hari": { "type": "string" },
        "tanggalPelaksanaan": { "type": "string" },
        "waktu": { "type": "string" },
        "lokasiSpesifik": { "type": "string" },
        "jumlahPeserta": { "type": "number" },
        "koordinat": { "type": "object" },
        "fotoList": { "type": "array" },
        "statusVerifikasi": { "type": "string" },
        "diverifikasiOleh": { "type": "string" },
        "catatanVerifikasi": { "type": "string" },
        "tanggalVerifikasi": { "type": "string" },
        "encryptedDataHash": { "type": "string" },
        "isEncrypted": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["penyuluhNama", "kelompokSasaran", "kategoriMateri", "judulMateri", "tanggalPelaksanaan"]
    },
    "notifikasi": {
      "title": "Notifikasi Admin",
      "description": "Pemberitahuan laporan dan verifikasi",
      "type": "object",
      "properties": {
        "judul": { "type": "string" },
        "pesan": { "type": "string" },
        "tipe": { "type": "string" },
        "timestamp": { "type": "string" },
        "dibaca": { "type": "boolean" },
        "laporanId": { "type": "string" },
        "penyuluhNama": { "type": "string" }
      },
      "required": ["judul", "pesan", "tipe", "timestamp"]
    },
    "user_profile": {
      "title": "Profil Pengguna",
      "description": "Data akun terdaftar Penyuluh Agama Islam atau Kepala KUA",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["penyuluh", "admin", "kemenag_kabupaten"] },
        "nama": { "type": "string" },
        "nip": { "type": "string" },
        "nipa": { "type": "string" },
        "jabatan": { "type": "string" },
        "pangkatGol": { "type": "string" },
        "kecamatan": { "type": "string" },
        "phone": { "type": "string" },
        "wilTugas": { "type": "string" },
        "unitKerja": { "type": "string" },
        "kuaName": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "nama", "nip", "kecamatan"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user_profile",
      "description": "Data profil akun Penyuluh Agama Islam dan Kepala KUA"
    },
    "/laporan_kegiatan/{laporanId}": {
      "schema": "laporan_kegiatan",
      "description": "Koleksi dokumen laporan kegiatan kepenyuluhan"
    },
    "/notifikasi/{notifikasiId}": {
      "schema": "notifikasi",
      "description": "Pemberitahuan verifikasi dan pengiriman laporan"
    }
  }
}
